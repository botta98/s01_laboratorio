; Exercício 4: let*, Alta Ordem e setf, Revisão Geral (Os Domínios de Teyvat)


(defstruct dominio
  nome
  elemento       ; uma keyword, como :pyro ou :cryo
  dificuldade    ; de 1 a 5
  mora)


; multiplicador da recompensa de cada elemento
(defun bonus-elemental (elemento)
  (case elemento
    (:electro  1.5)
    (:hydro    1.2)
    (otherwise 1)))


(defun recompensa-final (d)
  (* (dominio-mora d) (bonus-elemental (dominio-elemento d))))


; primeiro filtra, depois transforma em textos o que sobrou
(defun rota (lista dificuldade-maxima)
  (let* ((possiveis (remove-if-not
                     (lambda (d)
                       (<= (dominio-dificuldade d) dificuldade-maxima))
                     lista))
         (textos    (mapcar
                     (lambda (d)
                       (format nil "~a - ~,1f de mora"
                               (dominio-nome d) (recompensa-final d)))
                     possiveis)))
    textos))


(defun main ()
  (let ((dominios
          (list
           (make-dominio :nome "Valley of Remembrance" :elemento :anemo
                         :dificuldade 1 :mora 1200)
           (make-dominio :nome "Domain of Guyun" :elemento :geo
                         :dificuldade 2 :mora 1500)
           (make-dominio :nome "Midsummer Courtyard" :elemento :electro
                         :dificuldade 3 :mora 1800)
           (make-dominio :nome "Denouement of Sin" :elemento :hydro
                         :dificuldade 4 :mora 2100)
           (make-dominio :nome "Hidden Palace of Zhou Formula" :elemento :pyro
                         :dificuldade 4 :mora 2000)
           (make-dominio :nome "Peak of Vindagnyr" :elemento :cryo
                         :dificuldade 5 :mora 2500))))
    (format t "--- Rota ate a dificuldade 3 ---~%")
    (dolist (texto (rota dominios 3))
      (format t "~a~%" texto))
    (format t "Total de mora da lista: ~,1f~%"
            (reduce #'+ (mapcar #'recompensa-final dominios)))

    ; o Lisp permite alterar: o setf muda só a cópia
    (format t "--- Copia alterada com setf ---~%")
    (let ((copia (copy-dominio (car dominios))))
      (setf (dominio-mora copia) 5000)
      (format t "Mora da copia: ~a~%" (dominio-mora copia))
      (format t "Mora do original: ~a~%" (dominio-mora (car dominios))))))


(main)
