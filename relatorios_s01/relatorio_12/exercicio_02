-- Exercício 2: Funções de Alta Ordem e Imutabilidade (As Entregas da Kiki)


-- peso máximo (em kg) que a vassoura aguenta
pesoMaximo :: Double
pesoMaximo = 5.0
-- pesoMaximo = 8.0
-- erro ao compilar: Multiple declarations of 'pesoMaximo'


data Encomenda = Encomenda
  { destinatario :: String
  , peso         :: Double
  , frete        :: Double
  }


descrever :: Encomenda -> String
descrever enc =
  destinatario enc ++ " - " ++ show (peso enc) ++ " kg - frete R$ " ++ show (frete enc)


-- fica só o que a vassoura aguenta
cabemNaVassoura :: [Encomenda] -> [Encomenda]
cabemNaVassoura encomendas = filter (\enc -> peso enc <= pesoMaximo) encomendas


totalDeFretes :: [Encomenda] -> Double
totalDeFretes encomendas = sum (map frete encomendas)


main :: IO ()
main = do
  let encomendas =
        [ Encomenda { destinatario = "Ket", peso = 1.5, frete = 12.0 }
        , Encomenda { destinatario = "Neta da senhora", peso = 3.0, frete = 20.0 }
        , Encomenda { destinatario = "Padaria da Osono", peso = 8.0, frete = 35.0 }
        , Encomenda { destinatario = "Ursula", peso = 6.5, frete = 28.0 }
        ]
  let cabem = cabemNaVassoura encomendas

  putStrLn "--- Encomendas do dia ---"
  mapM_ putStrLn (map descrever encomendas)
  putStrLn "--- Cabem na vassoura ---"
  mapM_ putStrLn (map descrever cabem)
  putStrLn ("Total de fretes: R$ " ++ show (totalDeFretes cabem))
