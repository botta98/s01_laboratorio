class CoquetelAfterlife
  attr_reader :nome    # só leitura

  def initialize(nome, preco)
    @nome = nome
    @_preco = preco    # interno, sem attr_reader
  end

  # getter manual
  def preco
    @_preco
  end

  # setter manual: só aceita de 5 a 200
  def preco=(valor)
    if valor >= 5 && valor <= 200
      @_preco = valor
    else
      puts "Preço inválido!"
    end
  end

  # retorna o texto, não imprime
  def ficha
    "#{nome} | Preço: #{preco} eurodólares"
  end
end


# DrinkDeLenda herda de CoquetelAfterlife
class DrinkDeLenda < CoquetelAfterlife
  attr_reader :lenda

  def initialize(nome, preco, lenda)
    super(nome, preco)
    @lenda = lenda
  end

  # usa o texto do pai e adiciona a lenda
  def ficha
    super + " | Lenda: #{lenda}"
  end
end


