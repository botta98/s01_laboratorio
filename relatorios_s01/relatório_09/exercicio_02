# abstração: as filhas devem sobrescrever interpretar
class Instrumentista
  attr_reader :nome, :instrumento

  def initialize(nome, instrumento)
    @nome = nome
    @instrumento = instrumento
  end

  def interpretar(peca)
    raise NotImplementedError, "#{self.class} deve implementar interpretar"
  end
end


# sem initialize próprio, usa o do pai
class Solista < Instrumentista
  def interpretar(peca)
    puts "Na peça #{peca}, #{nome} (#{instrumento}) conduz a melodia principal."
  end
end


class Acompanhador < Instrumentista
  def interpretar(peca)
    puts "Na peça #{peca}, #{nome} (#{instrumento}) acompanha o ritmo do solista."
  end
end


class Regente
  def initialize(nome)
    @nome = nome
    @orquestra = []
  end

  def convocar(instrumentista)
    @orquestra << instrumentista
  end

  def reger(peca)
    puts "\n#{@nome} rege a peça #{peca}:"
    # cada um interpreta do seu jeito
    @orquestra.each do |musico|
      musico.interpretar(peca)
    end
  end

  # novo array de textos
  def escalacao
    @orquestra.map { |musico| "#{musico.class}: #{musico.nome}" }
  end
end


# --- MAIN --
puts "--- Concerto de Gala ---"

kaori = Solista.new("Kaori Miyazono", "violino")
kousei = Acompanhador.new("Kousei Arima", "piano")
seto = Regente.new("Hiroko Seto")

seto.convocar(kaori)
seto.convocar(kousei)
seto.reger("Introdução e Rondó Caprichoso")

puts "\n--- Escalação ---"
seto.escalacao.each do |texto|
  puts texto
end

