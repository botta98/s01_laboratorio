class UsuarioDeNen {
    constructor(nome) {
        this.nome = nome;
    }

    atacar(alvo) {
        console.log(`${this.nome} lança um ataque de aura contra ${alvo.nome}!`);
    }
}


// sem constructor próprio, usam o do pai
class Intensificador extends UsuarioDeNen {
    atacar(alvo) {
        console.log(`${this.nome} concentra a aura no punho e acerta ${alvo.nome} com o Jajanken!`);
    }
}

class Transmutador extends UsuarioDeNen {
    atacar(alvo) {
        console.log(`${this.nome} transforma a aura em eletricidade e dá um choque em ${alvo.nome}!`);
    }
}

class Materializador extends UsuarioDeNen {
    atacar(alvo) {
        console.log(`${this.nome} cria correntes de aura e prende ${alvo.nome}!`);
    }
}


class Aranha {
    constructor(nome, numero) {
        this.nome = nome;
        this.numero = numero;    // número tatuado
    }
}


// agregação: recebe Aranhas que já existem
class TrupeFantasma {
    #aranhas;    // privado

    constructor(cidade, aranhas = []) {
        this.cidade = cidade;
        this.#aranhas = aranhas;
    }

    revelarAranhas() {
        console.log(`\n--- Trupe Fantasma avistada em ${this.cidade} ---`);
        this.#aranhas.forEach(a => console.log(`Aranha nº ${a.numero}: ${a.nome}`));
    }

    buscarAranha(numero) {
        return this.#aranhas.find(a => a.numero === numero);
    }
}


// --- MAIN ---
console.log('--- As Aranhas de Yorknew ---');

// Aranhas criadas antes da Trupe
const nobunaga = new Aranha('Nobunaga', 1);
const uvogin = new Aranha('Uvogin', 11);

const trupe = new TrupeFantasma('Yorknew', [nobunaga, uvogin]);
trupe.revelarAranhas();

const alvo = trupe.buscarAranha(11);

const hunters = [
    new Intensificador('Gon'),
    new Transmutador('Killua'),
    new Materializador('Kurapika')
];

// find devolve undefined se não achar
if (alvo) {
    console.log(`\n--- Hunters contra a Aranha nº ${alvo.numero} ---`);
    // cada um ataca do seu jeito
    hunters.forEach(hunter => hunter.atacar(alvo));
}
