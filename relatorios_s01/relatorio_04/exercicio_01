package main

import "fmt"

// Recebe uma string, retorna um bool e uma string
func ValidarCodigoRastreio(codigo string) (bool, string) {
	if len(codigo) == 10 {
		return true, "Codigo de rastreio registrado no sistema!"
	}
	return false, "Erro: O codigo de rastreio deve ter exatamente 10 caracteres."
}

func main() {
	var codigo string

	// For infinito (estilo while sem condicao)
	for {
		fmt.Print("Digite o codigo de rastreio: ")

		_, err := fmt.Scanln(&codigo)

		// Se a leitura falhou, a entrada acabou. Encerra em vez de repetir sem fim.
		if err != nil {
			fmt.Println()
			fmt.Println("Entrada encerrada.")
			break
		}

		valido, mensagem := ValidarCodigoRastreio(codigo)

		fmt.Println(mensagem)

		if valido {
			break
		}
	}
}
