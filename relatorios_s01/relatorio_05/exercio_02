#include <iostream>
using namespace std;

float calcular_confiabilidade_sistema(float probabilidades[], int tamanho) {
    float resultado = 1.0;  // Comeca em 1 porque e multiplicacao

    for (int i = 0; i < tamanho; i++) {
        resultado = resultado * probabilidades[i];
    }

    return resultado;
}

int main() {
    int n;
    float probabilidades[100];  // Tamanho maximo fixo

    cout << "Digite a quantidade de componentes do sistema: " << endl;
    cin >> n;

    for (int i = 0; i < n; i++) {
        cout << "Digite a probabilidade do componente " << (i + 1) << " (ex: 0.95): " << endl;
        cin >> probabilidades[i];
    }

    float confiabilidade = calcular_confiabilidade_sistema(probabilidades, n);

    cout << "Confiabilidade total do sistema: " << confiabilidade << endl;
    cout << " (" << (confiabilidade * 100) << "%)" << endl;

    return 0;
}
